# Copy to .env and fill in. Never commit .env.
# Nothing here is required to START the system: without an LLM key Mira runs in offline mode
# (rule-based understanding, extractive answers). With a key, Gemini understands and words replies.

# --- Dates ---------------------------------------------------------------
# "Today" for pricing, deposits and expiry checks. The evals assume 2026-11-19.
TODAY=2026-11-19

# --- LLM -------------------------------------------------------------------
# Provider per role: "google" (Gemini, https://aistudio.google.com/apikey) or
# "deepseek" (https://platform.deepseek.com/api_keys, prepaid credit). No key = offline mode.
MIRA_LLM_PROVIDER=deepseek
JUDGE_LLM_PROVIDER=deepseek
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Mira's model: only extracts details and writes wording; never prices.
# Empty = provider default (deepseek-flash, or gemini-3.5-flash).
MIRA_MODEL=
# Gemini only: backups tried in order if the main model is overloaded (503) or out of quota (429).
MIRA_FALLBACK_MODELS=gemini-2.5-flash
# Model routing (bonus, Gemini): short single-request messages use this small model; answers,
# drafts and longer messages use MIRA_MODEL. Empty or MIRA_ROUTING=off = one model for everything.
MIRA_SMALL_MODEL=gemini-3.5-flash-lite
MIRA_ROUTING=on
# Eval judge: a DIFFERENT, stronger model than Mira.
# Empty = provider default (deepseek-v4-pro with light reasoning, or gemini-3.6-flash).
JUDGE_MODEL=
JUDGE_FALLBACK_MODELS=gemini-3.7-flash

# --- Tracing (Langfuse, https://cloud.langfuse.com). Empty = local JSON traces only (traces/).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region URL shown in Langfuse (e.g. https://us.cloud.langfuse.com). LANGFUSE_HOST is also accepted.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Pricing -------------------------------------------------------------
# Optional JSON file overriding workbook Settings for the live demo, e.g. config/pricing_overrides.json
# containing {"margin_day_tour": "0.35"}. Leave empty to use the workbook only.
PRICING_OVERRIDES_FILE=

# --- App -----------------------------------------------------------------
DATABASE_URL=sqlite:///mira.db
BACKEND_PORT=8123
FRONTEND_PORT=3000
# Frontend -> backend URL (defaults to http://127.0.0.1:BACKEND_PORT)
MIRA_BACKEND_URL=
# Signs staff login tokens. Empty = a random secret per run (staff log in again after a restart).
APP_SECRET=
# Demo staff users (no real people). Change these for anything beyond a demo.
STAFF_PASSWORD=staff-demo
APPROVER_PASSWORD=approver-demo
# Mock payment: true forces the payment step to fail (shows the friendly failure path).
# You can also add ?failpay=1 to the chat page URL.
MOCK_PAYMENT_FAIL=false
