# Copy to .env and fill in. Never commit .env.
# Only the LLM key is required to run the app. Everything else has a safe default.

# --- Dates ---------------------------------------------------------------
# "Today" for pricing, deposits and expiry checks. The evals assume 2026-11-19.
TODAY=2026-11-19

# --- LLM (Phase 4) -------------------------------------------------------
# Provider and model for Mira. The model ids are set when the agent is built.
MIRA_LLM_PROVIDER=google
GOOGLE_API_KEY=
MIRA_MODEL=
# The eval judge must use a different (ideally stronger) model than Mira.
JUDGE_LLM_PROVIDER=
JUDGE_API_KEY=
JUDGE_MODEL=

# --- Tracing (Phase 6). If these are empty, tracing is a no-op with a warning.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Pricing -------------------------------------------------------------
# Optional JSON file that overrides workbook Settings (e.g. a margin) for the live demo.
# See config/pricing_overrides.example.json. Leave empty to use the workbook only.
PRICING_OVERRIDES_FILE=

# --- App -----------------------------------------------------------------
DATABASE_URL=sqlite:///mira.db
BACKEND_PORT=8123
FRONTEND_PORT=3000
# Mock payment: set to true to force the booking/payment step to fail (demo of the friendly failure path).
MOCK_PAYMENT_FAIL=false
